{
  "name": "chatforyou-frontend",
  "version": "1.1.5",
  "description": "Node.js static server for ChatForYou frontend",
  "main": "server.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.js",
    "local": "cp ./config/config.local.js ./config/config.js && echo '로컬 빌드 완료'",
    "prod": "cp ./config/config.prod.js ./config/config.js && echo '운영 빌드 완료'",
    "sass": "sass --watch static/scss/main.scss static/css/chatroom/common.css",
    "dev": "npm run build && concurrently \"npm run sass\" \"vite build --watch\" \"node server.js\"",
    "test": "vitest run",
    "syntax": "bash ../scripts/verify-frontend-syntax.sh",
    "lint": "eslint .",
    "lint:changed": "bash ../scripts/verify-frontend-lint.sh",
    "build": "vite build"
  },
  "author": "sejon",
  "license": "by-nc-sa 4.0",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
